@model IEnumerable<prjFinalProjectApi.Models.SuppliesSupplier>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.SuppliesSupplierName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.SuppliesSupplierGui)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ContactPerson)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ContactNumber)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Address)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.SupplierKeyword)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Continued)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.SuppliesSupplierName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.SuppliesSupplierGui)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ContactPerson)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ContactNumber)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Address)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.SupplierKeyword)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Continued)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.SuppliesSupplierId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.SuppliesSupplierId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.SuppliesSupplierId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
